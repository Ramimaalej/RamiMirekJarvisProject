      "^(c?est\\s+quoi|qu?est\\s+-?ce\\s+que)\\s+(contient|dit)\\s+(ce\\s+|ce\\s+pdf|le\\s+pdf)\\s*",
      "(explain|explique|résume|resumé)\\s+(this\\s+|that\\s+|le\\s+|ce\\s+)?(pdf|document)\\s*",
      "^(open|show)\\s+the\\s+(content\\s+of\\s+)?my\\s+(latest\\s+|recent\\s+)?pdf"
