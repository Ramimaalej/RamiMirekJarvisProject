      "^(solve|calculate|calculer|résous|résoudre)\\s+(the\\s+)?(equation\\s+|expression\\s+)?\\d",
      "\\d+\\s*[+\\-*/^]\\s*\\d",
      "\\d+\\s*[*x×]\\s*\\d+"
    ],
    "handler": "math_solver",
    "requires_ai": false
  },
  {
    "name": "hash_tools",
    "subsystem": "tools",
    "patterns": [
