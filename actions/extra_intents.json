      "^(define|définir|définition\\s+de|definition\\s+of|meaning\\s+of)\\s+\\w+",
      "^(synonyms?\\s+of|synonymes?\\s+de)\\s+\\w+",
      "^\\w+\\s+synonyms?\\b"
    ],
    "handler": "dictionary_tools",
    "requires_ai": false
  },
  {
    "name": "math_solver",
    "subsystem": "tools",
    "patterns": [
