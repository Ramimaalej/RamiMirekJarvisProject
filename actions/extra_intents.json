      "^(md5|sha\\s*256|sha\\s*1|sha512|checksum)\\s+(of\\s+|de\\s+)?(the\\s+|le\\s+|ce\\s+)?(file|fichier)\\s*",
      "^(compute|calcul|génère|generate)\\s+(the\\s+|un\\s+)?(md5|sha|checksum)\\s+"
