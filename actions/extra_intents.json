    "patterns": [
      "^(generate|create|make|fais|génère)\\s+(a\\s+)?(qr\\s*code|qr)\\s+(for|pour)\\s+",
      "^(read|scan|lire|scanner|décoder|decode)\\s+(a\\s+|this\\s+|le\\s+|ce\\s+)?(qr\\s*code|qr)\\s*",
      "\\b(qr\\s*code|qr)\\s+(for|pour)\\s+"
    ],
    "handler": "qr_tools",
    "requires_ai": false
  },
  {
    "name": "clipboard_mgr",
    "subsystem": "tools",
    "patterns": [
      "^(what|whats|qu?est)\\s*(-?ce\\s+que\\s+(-?il\\s+y\\s+a)?\\s*)?(is\\s+|il\\s+y\\s+a)?\\s*(in\\s+)?(my\\s+)?clipboard",
      "^(lis|montrer|voir|read|show)\\s+(mon\\s+|my\\s+)?(presse[- ]?papiers|clipboard)",
      "^(copy|copie|copier|colle|coller)\\s+.*\\b(clipboard|presse[- ]?papiers)\\b",
      "\\bclipboard\\b"
    ],
    "handler": "clipboard_mgr",
    "requires_ai": false
  },
  {
    "name": "dictionary_tools",
