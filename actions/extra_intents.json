      "^(bitcoin|ethereum|eth|solana|doge|dogecoin|crypto)\\s+(price|prix|cours)",
      "^(prix|price)\\s+(of\\s+|du\\s+)?(bitcoin|ethereum|btc|eth|crypto)",
